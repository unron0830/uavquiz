<?xml version="1.0" encoding="utf-8"?>
<!--
  無人機知識王（ASP.NET 版）
  - 需要 IIS 的「ASP.NET 4.8」功能（Windows 功能 → Internet Information Services → World Wide Web 服務 → 應用程式開發功能 → ASP.NET 4.8）
  - 不需要 URL Rewrite、ARR、WebSocket、Node.js；可放在站台根目錄或任何子資料夾
  - 程式全部在 api.ashx（IIS 第一次呼叫時自動編譯）
  - 資料在 App_Data（IIS 會阻擋外部直接下載）
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".bat" />
          <add fileExtension=".bat" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
