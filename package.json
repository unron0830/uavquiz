{
  "name": "uav-quiz-arena",
  "private": true,
  "version": "1.0.0",
  "description": "無人機知識王 — 自架即時競賽系統",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/shared",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p apps/web --noEmit",
    "test": "vitest run tests/scoring.test.ts tests/name-security.test.ts tests/explanation-format.test.ts",
    "package:iis": "python scripts/package-iis.py"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "4.1.12"
  }
}